[user]
  useConfigOnly = true

[init]
  defaultBranch = main

[core]
  editor = nvim
  excludesFile = ~/.config/git/ignore
  autocrlf = input

[status]
  short = true
  branch = true

[branch]
  sort = -committerdate

[pull]
  rebase = false

[commit]
  verbose = true

[push]
  default = simple
  autoSetupRemote = true

[fetch]
  prune = true
  pruneTags = true

[merge]
  conflictStyle = zdiff3

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true

[rerere]
  enabled = true

[tag]
  sort = version:refname

[column]
  ui = auto

[color]
  ui = auto

[alias]
  st = status
  sw = switch
  co = checkout
  br = branch
  ci = commit
  lg = log --graph --oneline --decorate --all

[log]
  date = iso

[help]
  autocorrect = prompt

[include]
  path = ~/.config/git/user
