[user]
  useConfigOnly = true

[init]
  defaultBranch = main

[core]
  editor = nvim
  excludesFile = ~/.config/git/ignore
  autocrlf = input

[pull]
  rebase = false

[push]
  default = simple
  autoSetupRemote = true

[fetch]
  prune = true
  pruneTags = true

[rerere]
  enabled = true

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[column]
  ui = auto

[color]
  ui = auto

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true

[merge]
  conflictStyle = zdiff3

[help]
  autocorrect = prompt

[include]
  path = ~/.config/git/user
