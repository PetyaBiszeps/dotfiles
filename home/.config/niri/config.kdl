// ─────────────────────────────────────────────────────────────
// Modules
// ─────────────────────────────────────────────────────────────

include "noctalia.kdl"

// ─────────────────────────────────────────────────────────────
// Input
// ─────────────────────────────────────────────────────────────

input {
  keyboard {
    repeat-delay 600
    repeat-rate 25
    track-layout "global"
  }

  touchpad {
    tap
    natural-scroll
  }
}

// ─────────────────────────────────────────────────────────────
// General
// ─────────────────────────────────────────────────────────────

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

prefer-no-csd

cursor {
  xcursor-theme "default"
  xcursor-size 24
}

// ─────────────────────────────────────────────────────────────
// Layout
// ─────────────────────────────────────────────────────────────

layout {
  gaps 16

  struts {
    left 0
    right 0
    top 0
    bottom 0
  }

  focus-ring {
    off
  }

  border {
    width 2
    urgent-color "#B14D4D"
    active-color "#7F8B9B"
    inactive-color "#2B3036"
  }

  shadow {
    on
    offset x=0 y=6
    softness 24
    spread 2
    draw-behind-window false
    color "#00000066"
  }

  default-column-width {
    proportion 0.5
  }

  center-focused-column "never"
}

// ─────────────────────────────────────────────────────────────
// Keybinds
// ─────────────────────────────────────────────────────────────

binds {
  Mod+Q hotkey-overlay-title="Open Terminal: Ghostty" {
    spawn "ghostty"
  }

  Mod+B hotkey-overlay-title="Open Browser: Brave" {
    spawn "brave"
  }

  Mod+E hotkey-overlay-title="Open Files: Nautilus" {
    spawn "nautilus"
  }

  Mod+I hotkey-overlay-title="Open Editor: Zed" {
    spawn "zeditor"
  }

  Mod+R hotkey-overlay-title="Open Launcher" {
    spawn "noctalia" "msg" "panel-toggle" "launcher"
  }

  Mod+C hotkey-overlay-title="Close Window" {
    close-window
  }

  Mod+F hotkey-overlay-title="Maximize Column" {
    maximize-column
  }

  Mod+Shift+F hotkey-overlay-title="Fullscreen Window" {
    fullscreen-window
  }

  Mod+Print hotkey-overlay-title="Screenshot Area to Clipboard" {
    spawn "noctalia" "msg" "screenshot-region"
  }
}

// ─────────────────────────────────────────────────────────────
// Startup
// ─────────────────────────────────────────────────────────────

spawn-at-startup "noctalia"

// ─────────────────────────────────────────────────────────────
// Window rules
// ─────────────────────────────────────────────────────────────

window-rule {
  geometry-corner-radius 12 12 12 12
  clip-to-geometry true
}

window-rule {
  match app-id="steam"
  open-floating true
}

window-rule {
  match app-id="steam" title="^Steam$"
  open-floating false
}

window-rule {
  match app-id="steam" title="^Steam Overlay$"
  open-floating false
}

